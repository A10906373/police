cq5ww"><section class="Primer_Brand__Section-module__Section___O2zvq Primer_Brand__Section-module__Section--paddingBlockStart-none___4vMFc Primer_Brand__Section-module__Section--paddingBlockEnd-none___bRHMx base-module__gridFrameTop__Fmv3a" data-testid="Section" style="--brand-Section-background-image-position:50%;--brand-Section-background-image-size:cover"><div class="Primer_Brand__Section-module__Section__container___xy9DV Primer_Brand__Section-module__Section__container--fullWidth___5sU9n" data-testid="Section__container"><figure class="Primer_Brand__Testimonial-module__Testimonial___kxB6R Primer_Brand__Testimonial-module__Testimonial--variant-expressive___J1PIY Primer_Brand__Testimonial-module__Testimonial--size-large___NH7Vg Primer_Brand__Testimonial-module__Testimonial--border___pbUPS" style="--testimonial-accent-color:green"><div class="Primer_Brand__Testimonial-module__Testimonial__quoteWrapper___vcgUf"><div aria-hidden="true" class="Primer_Brand__Testimonial-module__Testimonial__quoteMark___sC3I2 Primer_Brand__Testimonial-module__Testimonial__quoteMark--green___zmlvZ Primer_Brand__Testimonial-module__Testimonial__quoteMark--hasBackground___AUVX2"><span class="Primer_Brand__Testimonial-module__Testimonial__quoteMarkGlyph___1eZ5L">“</span></div><blockquote><span class="Primer_Brand__Text-module__Text___XeGJJ Primer_Brand__Text-module__Text-font--mona-sans___a8XJD Primer_Brand__Text-module__Text--default___GhPh_ Primer_Brand__Text-module__Text--200____P1wy Primer_Brand__Text-module__Text--antialiased___TYoXS Primer_Brand__Testimonial-module__Testimonial-quote___xbxri">G<!-- -->itHub Desktop is really one of the best 80/20 programs I have seen. It hides the details of git (which are irrelevant) and just lets you get on with your work.</span></blockquote></div><div class="Primer_Brand__Testimonial-module__Testimonial__media___rvn7k"><figcaption class="Primer_Brand__Testimonial-module__Testimonial-caption___8c_KF"><span class="Primer_Brand__Text-module__Text___X